MONGODB_URI=mongodb://localhost:27017/pharmastackx
AUTH_SECRET=replace-with-a-long-random-string
# Shown on the login screen. Each white-labeled deployment can set its own — defaults to "PharmaStackX POS".
LOGIN_BRAND_NAME=PharmaStackX POS

# Daily database backup (src/app/api/cron/backup) — Vercel Cron sends this back as a
# bearer token so only Vercel's own scheduler can trigger a dump. Generate any long random string.
CRON_SECRET=replace-with-a-long-random-string
# Auto-added to your Vercel project's env vars once you connect a Blob store to it
# (Vercel dashboard -> Storage -> Create Database -> Blob -> Connect Project). Not needed locally
# unless you want to test the backup route against a real Blob store.
BLOB_READ_WRITE_TOKEN=

# Gates /onboard (internal tool for creating new pharmacies via a web form instead of the
# onboard.mjs CLI script). Generate any long random string and keep it secret.
PLATFORM_ONBOARD_SECRET=replace-with-a-long-random-string
